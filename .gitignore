# Secrets: never commit passwords, keys or tokens
# (CAS and mail passwords live in Windows Credential Manager via keyring;
#  secrets/ is a catch-all in case a secret file is ever created)
secrets/
.env
.env.*
*.key
*.pem
token*.json
credentials*.json

# Personal data: statements contain PAN, account and holding details
samples/
data/
inbox/
quarantine/

# Probe scripts and output from Phase 1 discovery (throwaway)
scratch/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Database and local runtime
*.dump
*.sql.gz
pgdata/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
